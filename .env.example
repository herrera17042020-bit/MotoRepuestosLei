# Copia este archivo como ".env" y completa tus datos reales.
# NUNCA subas el archivo ".env" real a un repositorio.

# Conexion PostgreSQL para Prisma. En Supabase usa la URL de Connect >
# Pooling > Session pooler (o la conexión directa si tu servidor lo permite).
# Nunca publiques esta URL: contiene la contraseña de la base.
DATABASE_URL="postgresql://postgres:CONTRASENA@localhost:5432/MotorepuestosLei"

# Puerto en el que correra el servidor Express
PORT=3000

# Entorno de ejecucion
NODE_ENV=development

# ---------------------------------------------------------------------------
# SEGURIDAD: contrasenas de la tienda (una para cada accion, todas DISTINTAS)
# Elige contrasenas propias y largas. NO las escribas en este archivo de ejemplo,
# solo en tu archivo ".env" real (que nunca se sube a un repositorio).
# ---------------------------------------------------------------------------

# Contrasena para entrar a la pantalla de Inventario y modificar productos/categorias
INVENTARIO_PASSWORD=

# Contrasena para modificar ventas DEL DIA
VENTAS_MODIFICAR_PASSWORD=

# Contrasena para eliminar ventas (debe ser diferente a la de modificar)
VENTAS_ELIMINAR_PASSWORD=

# Clave interna para firmar las sesiones autorizadas (texto largo y aleatorio).
# Generala con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Zona horaria del negocio: define cuando termina "el dia" para las ventas modificables
APP_TIMEZONE=America/Managua

# Opcional: duracion de las autorizaciones, en minutos (valores por defecto)
# AUTH_TOKEN_INVENTARIO_MIN=480
# AUTH_TOKEN_VENTAS_MIN=10

# Configuracion para app Android/cliente web en la nube.
# Define la URL publica de la API (sin /api).
# Ejemplo: https://api.tuempresa.com
# API_BASE_URL=

# CORS permitido para la API en internet. Para APK Capacitor incluye
# capacitor://localhost y http://localhost; agrega también el dominio web si existe.
# CORS_ORIGINS=
